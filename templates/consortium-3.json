{
  "schema_version": 1,
  "name": "consortium-3",
  "display_name": "Consortium 3",
  "description": "Three-validator starter shape with dashboard and monitoring defaults for a small shared-state network.",
  "block_policy_mode": "idle_interval",
  "block_policy_interval": "10s",
  "parallel_execution_enabled": false,
  "parallel_execution_workers": 4,
  "parallel_execution_min_transactions": 8,
  "operator_profile": "shared_network",
  "monitoring_profile": "bds",
  "bootstrap_node_name": "validator-1",
  "additional_validator_names": [
    "validator-2",
    "validator-3"
  ],
  "services": {
    "bds": {
      "enabled": true
    },
    "dashboard": {
      "enabled": true,
      "host": "0.0.0.0",
      "port": 18080
    },
    "monitoring": {
      "enabled": true
    }
  },
  "advanced": {
    "metrics": {
      "host": "0.0.0.0"
    }
  },
  "pruning_enabled": false,
  "blocks_to_keep": 100000
}
