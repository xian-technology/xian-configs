{
  "schema_version": 1,
  "name": "consortium-5",
  "display_name": "Consortium 5",
  "description": "Five-validator starter shape with dashboard and monitoring defaults for heavier shared-state and governance testing.",
  "block_policy_mode": "idle_interval",
  "block_policy_interval": "10s",
  "operator_profile": "shared_network",
  "bootstrap_node_name": "validator-1",
  "additional_validator_names": [
    "validator-2",
    "validator-3",
    "validator-4",
    "validator-5"
  ],
  "services": {
    "bds": {
      "enabled": true
    },
    "dashboard": {
      "enabled": true,
      "host": "0.0.0.0",
      "port": 18080
    },
    "monitoring": {
      "enabled": true
    }
  },
  "pruning_enabled": false,
  "blocks_to_keep": 100000
}
