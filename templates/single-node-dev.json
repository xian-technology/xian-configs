{
  "schema_version": 1,
  "name": "single-node-dev",
  "display_name": "Single-Node Dev",
  "description": "Full local development node with indexed reads, GraphQL, dashboard, and monitoring enabled.",
  "block_policy_mode": "periodic",
  "block_policy_interval": "5s",
  "operator_profile": "local_development",
  "bootstrap_node_name": "validator-1",
  "services": {
    "bds": {
      "enabled": true
    },
    "dashboard": {
      "enabled": true,
      "port": 18080
    },
    "monitoring": {
      "enabled": true
    }
  }
}
