{
  "schema": "xian.contract_pack.v1",
  "schema_version": 1,
  "name": "nft",
  "display_name": "NFT Contract Pack",
  "category": "protocol",
  "maturity": "candidate",
  "description": "XSC-0005 checker and reference NFT collection contracts for the xian-nft product and PixelSnek marketplace.",
  "source_owner_repo": "xian-nft",
  "docs_path": "/contract-packs/nft",
  "default_recipe": "reference-marketplace",
  "contract_paths": [
    "contract-packs/nft/contracts/con_xsc005.s.py",
    "contract-packs/nft/contracts/con_xsc005_nft.s.py"
  ],
  "contract_bundle_paths": [
    "contract-packs/nft/contract-bundle.json"
  ],
  "recipes": [
    {
      "name": "checker-only",
      "display_name": "XSC-0005 Checker",
      "summary": "Deploy only the XSC-0005 interface checker contract.",
      "install": {
        "kind": "external",
        "repo": "xian-nft",
        "command": "uv run --group deploy python scripts/bootstrap_nft.py --checker-only"
      }
    },
    {
      "name": "reference-marketplace",
      "display_name": "Reference NFT Marketplace",
      "summary": "Deploy the XSC-0005 checker and reference collection for PixelSnek/local marketplace demos.",
      "install": {
        "kind": "external",
        "repo": "xian-nft",
        "command": "uv run --group deploy python scripts/bootstrap_nft.py"
      }
    }
  ]
}
