{
  "schema": "xian.contract_pack.v1",
  "schema_version": 1,
  "name": "dex",
  "display_name": "DEX Contract Pack",
  "category": "protocol",
  "maturity": "candidate",
  "description": "Canonical Xian AMM contracts under stable contract names for wallets, frontend flows, automation, and tests.",
  "source_owner_repo": "xian-dex",
  "docs_path": "/contract-packs/dex",
  "default_recipe": "core",
  "contract_paths": [
    "contract-packs/dex/contracts/con_pairs.s.py",
    "contract-packs/dex/contracts/con_dex.s.py",
    "contract-packs/dex/contracts/con_dex_helper.s.py",
    "contract-packs/dex/contracts/con_lp_token.s.py",
    "contract-packs/dex/contracts/demo_token.s.py"
  ],
  "contract_bundle_paths": [
    "contract-packs/dex/contract-bundle.json"
  ],
  "recipes": [
    {
      "name": "core",
      "display_name": "Core DEX Contracts",
      "summary": "Deploy the canonical DEX contracts without demo liquidity.",
      "install": {
        "kind": "external",
        "repo": "xian-dex",
        "command": "uv run python scripts/bootstrap_dex.py --recipe core"
      }
    },
    {
      "name": "local-demo",
      "display_name": "Local Demo DEX",
      "summary": "Deploy the canonical DEX contracts plus a demo token, LP token, and seeded XIAN/XDT pool.",
      "install": {
        "kind": "external",
        "repo": "xian-dex",
        "command": "uv run python scripts/bootstrap_dex.py --recipe local-demo"
      }
    },
    {
      "name": "production",
      "display_name": "Production DEX Core",
      "summary": "Deploy the canonical DEX contracts without local-only demo assets.",
      "install": {
        "kind": "external",
        "repo": "xian-dex",
        "command": "uv run python scripts/bootstrap_dex.py --recipe production"
      }
    }
  ]
}
