{
  "schema": "xian.product.v1",
  "schema_version": 1,
  "name": "dex",
  "display_name": "Xian DEX",
  "category": "on_chain_product",
  "maturity": "candidate",
  "description": "Xian AMM product composed of canonical DEX contracts, SnakX web UI, and optional automation services.",
  "source_owner_repo": "xian-dex",
  "docs_path": "/products/dex",
  "contract_packs": [
    {
      "name": "dex",
      "recipe": "core",
      "required": true
    }
  ],
  "examples": [
    "dex-demo"
  ],
  "apps": [
    {
      "name": "snakx",
      "kind": "web",
      "repo": "xian-dex",
      "path": "web",
      "description": "DEX web application."
    }
  ],
  "services": [
    {
      "name": "dex-automation",
      "kind": "automation",
      "repo": "xian-dex-automation",
      "description": "Optional deterministic DEX automation sidecar.",
      "optional": true
    }
  ],
  "lifecycle": {
    "install_phase": "post_genesis",
    "included_in_genesis": false,
    "shipped_with_node_image": false,
    "installer": {
      "kind": "contract-pack",
      "contract_pack": "dex",
      "recipe": "core",
      "repo": "xian-dex",
      "command": "uv run python scripts/bootstrap_dex.py --recipe core"
    }
  }
}
